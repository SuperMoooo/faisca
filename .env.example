# Copy to .env and fill in. Read by docker-compose.yml and by the backend
# (backend/.env when running it with uv). Every key is a field on Settings
# (backend/src/faisca/core/config.py); real environment variables win.

# local | test | staging | production (production logs one JSON object per line)
ENVIRONMENT=local
# Interactive API docs at /docs; set false to hide them.
API_DOCS_ENABLED=true
LOG_LEVEL=INFO

# Sent in the User-Agent to every external catalogue and API, as their
# terms ask, so an operator can contact you instead of blocking you.
CONTACT_EMAIL=

# Free key: https://pro.europeana.eu/page/get-api (without it Europeana is skipped).
EUROPEANA_API_KEY=
# Optional: https://console.cloud.google.com/apis/library/books.googleapis.com
# Without it, Google Books shares an anonymous quota that is often exhausted.
GOOGLE_BOOKS_API_KEY=

# How long live answers are reused (hours).
CACHE_TTL_HOURS=24
# Records fetched per catalogue per search.
MAX_RECORDS_PER_TARGET=20
# Politeness per external service: requests in flight, and seconds between starts.
MAX_CONCURRENT_REQUESTS_PER_TARGET=2
MIN_SECONDS_BETWEEN_REQUESTS=1.0

# Set by the Docker image; only needed when running the backend by hand
# from another folder.
# DATABASE_URL=sqlite+aiosqlite:///./faisca.db
# TARGETS_FILE=../config/targets.yaml
# WEB_DIST_DIR=../web/out
